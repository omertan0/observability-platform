POSTGRES_USER=observability
POSTGRES_DB=observability
POSTGRES_PASSWORD=buraya_guclu_bir_parola_yazin
# Windows API için havuz üst sınırı; worker Compose içinde süreç başına 2 kullanır.
DB_POOL_MAX=8
API_REQUEST_TELEMETRY_ENABLED=true

# python scripts/setup_access.py ile doldurulur. Şifre en az 16, anahtar en az 32 karakter.
PANEL_USERNAME=admin
PANEL_PASSWORD=
INGEST_API_KEY=
# Yerelde HTTP için false; internette HTTPS üzerinden yayınlarken true olmalı.
SESSION_COOKIE_SECURE=false
PANEL_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000

# Docker paneli; Windows/Vite geliştirme adreslerinden ayrı tutulur.
PANEL_BIND_ADDRESS=127.0.0.1
PANEL_HTTP_PORT=8080
DOCKER_PANEL_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
# Port/adres değişirse DOCKER_PANEL_ALLOWED_ORIGINS de aynı adresi içermeli.
# Canlı HTTPS adresi hazır olduğunda buraya yazılır ve SESSION_COOKIE_SECURE=true yapılır.
